# 统一行尾，避免跨平台 diff 噪声与守门脚本误报
* text=auto eol=lf

# Windows 专用文件保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# 二进制，不做任何行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.7z    binary
*.so    binary
*.dylib binary
*.a     binary
*.aar   binary
*.jar   binary
*.mp4   binary
*.mp3   binary

# 生成物不计入语言统计
*.g.dart        linguist-generated=true
*.freezed.dart  linguist-generated=true
